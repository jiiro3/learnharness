<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <!-- The WebView is created in code and added here, so a new server gets a fresh one. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- The native panels are clickable so a tap on them never reaches the WebView underneath. -->
    <ScrollView
        android:id="@+id/error_panel"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lh_background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/error_title"
                android:textAppearance="@android:style/TextAppearance.Material.Headline"
                android:textColor="@color/lh_on_background" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textColor="@color/lh_secondary"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minWidth="160dp"
                android:text="@string/error_retry" />

            <Button
                android:id="@+id/error_settings"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/server_settings" />
        </LinearLayout>
    </ScrollView>

    <!-- Shown while a cold-starting server is retried (WakeRetry); dark like the web app. -->
    <LinearLayout
        android:id="@+id/waking_panel"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lh_web_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/lh_waking_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/waking"
            android:textAppearance="@android:style/TextAppearance.Material.Body1"
            android:textColor="@color/lh_waking_text" />
    </LinearLayout>

    <!-- In-app update prompt (Updater). Non-blocking: the page stays usable around it. -->
    <FrameLayout
        android:id="@+id/update_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/update_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/update_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textColor="@color/lh_waking_text" />

            <Button
                android:id="@+id/update_later"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_later"
                android:textColor="@color/lh_update_secondary" />

            <Button
                android:id="@+id/update_install"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_install"
                android:textColor="@color/lh_waking_text" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/setup_panel"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lh_background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text="@string/setup_title"
                android:textAppearance="@android:style/TextAppearance.Material.Headline"
                android:textColor="@color/lh_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_horizontal"
                android:text="@string/setup_body"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textColor="@color/lh_secondary" />

            <TextView
                android:id="@+id/setup_url_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_url_label"
                android:textColor="@color/lh_secondary" />

            <EditText
                android:id="@+id/setup_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="url"
                android:hint="@string/setup_url_hint"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/setup_token_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_token_label"
                android:textColor="@color/lh_secondary" />

            <EditText
                android:id="@+id/setup_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/setup_token_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/setup_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_save" />

            <Button
                android:id="@+id/setup_cancel"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
