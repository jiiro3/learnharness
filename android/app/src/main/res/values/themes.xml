<resources>
    <!-- Light/dark pair: isLightTheme also drives the WebView's prefers-color-scheme. -->
    <style name="Theme.LearnHarness" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lh_background</item>
        <item name="android:colorAccent">@color/lh_accent</item>
        <item name="android:colorPrimary">@color/lh_accent</item>
        <item name="android:textColorPrimary">@color/lh_on_background</item>
        <item name="android:textColorSecondary">@color/lh_secondary</item>
    </style>
</resources>
